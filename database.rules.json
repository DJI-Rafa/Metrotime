{
  "rules": {
    "cp_avisos": {
      ".read": true,
      ".write": false
    },
    "cp_vehicles": {
      ".read": true,
      ".write": false
    },
    "cp_positions": {
      ".read": "auth != null",
      ".write": false
    },
    "cp_suppressions": {
      ".read": true,
      ".write": false
    },
    "cp_routes": {
      ".read": true,
      ".write": false
    },
    "cp_samples": {
      ".read": false,
      ".write": false
    },

    "transit_packs": {
      ".read": true,
      ".write": false
    },
    "transit_packs_index": {
      ".read": true,
      ".write": false
    },
    "regional_live": {
      ".read": true,
      ".write": false
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "admin_password": {
      ".read": false,
      ".write": false
    },

    "maintenance_mode": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.isBoolean()"
    },
    "global_alert": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['active', 'text'])",
      "active": { ".validate": "newData.isBoolean()" },
      "text": { ".validate": "newData.isString() && newData.val().length <= 300" },
      "$other": { ".validate": false }
    },
    "app_update": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".validate": "newData.hasChildren(['versionCode', 'downloadUrl'])",
      "versionCode": { ".validate": "newData.isNumber() && newData.val() > 0" },
      "versionName": { ".validate": "newData.isString() && newData.val().length <= 30" },
      "releaseNotes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
      "downloadUrl": { ".validate": "newData.isString() && newData.val().beginsWith('https://') && newData.val().length <= 1000" },
      "forceUpdate": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },

    "adminMessages": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$msgId": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid == $uid && !newData.exists()))",
          ".validate": "newData.isString() && newData.val().length <= 1000"
        }
      }
    },
    "user_notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "photoUrl": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "$other": { ".validate": false }
      }
    },
    "profile_photos": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isString() && newData.val().length <= 200000"
      }
    },
    "email_index": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email != null && $emailKey === auth.token.email.toLowerCase().replace('.', ',') && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.val() === auth.uid"
      }
    },

    "locations": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friends').child($uid).child(auth.uid).val() === 'accepted')",
        ".write": "auth != null && auth.uid == $uid",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "currentTrain": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "trainDestination": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$friendUid": {
          ".write": "auth != null && $uid != $friendUid && ((!newData.exists() && (auth.uid == $uid || auth.uid == $friendUid)) || (auth.uid == $uid && newData.val() === 'pending_sent' && !data.exists()) || (auth.uid == $uid && newData.val() === 'accepted' && data.val() === 'pending_received') || (auth.uid == $friendUid && newData.val() === 'pending_received' && !data.exists()) || (auth.uid == $friendUid && newData.val() === 'accepted' && data.val() === 'pending_sent'))",
          ".validate": "newData.isString()"
        }
      }
    },

    "user_stats": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friends').child($uid).child(auth.uid).val() === 'accepted' || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid == $uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        "totalVisits": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() <= data.val() + 20)" },
        "totalDistanceKm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && (!data.exists() || newData.val() <= data.val() + 5000)" },
        "travelMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() <= data.val() + 600)" },
        "timeSavedMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "currentStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3650" },
        "longestStreak": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3650" },
        "monthlyVisits": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('totalVisits').val()" },
        "previousMonthVisits": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "monthKey": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)" },
        "lastTripDay": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" }
      }
    },

    "user_badges": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('friends').child($uid).child(auth.uid).val() === 'accepted' || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid == $uid || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['updatedAt'])",
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 300000" },
        "earned": {
          "$badge": { ".validate": "$badge.length <= 40 && newData.isNumber() && newData.val() >= 18000 && newData.val() <= 40000" }
        },
        "labels": {
          "$badge": { ".validate": "$badge.length <= 40 && newData.isString() && newData.val().length <= 40" }
        },
        "$other": { ".validate": false }
      }
    },
    "badge_counts": {
      ".read": "auth != null",
      ".write": false
    },

    "station_reports": {
      ".read": "auth != null",
      "$stationId": {
        "$issue": {
          ".write": "auth != null && $stationId.length <= 40 && ((newData.exists() && $issue.length <= 80 && newData.isNumber() && newData.val() <= now + 300000 && newData.val() >= now - 300000) || (!newData.exists() && (root.child('admins').child(auth.uid).val() === true || data.val() < now - 259200000)))"
        }
      }
    }
  }
}
